{
	"name": "IPLSinkDataset",
	"properties": {
		"linkedServiceName": {
			"referenceName": "IPLSinkLS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"value1": {
				"type": "String",
				"defaultValue": "\"random\""
			},
			"value2": {
				"type": "String",
				"defaultValue": "\"random\""
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@concat(dataset().value1, '_',dataset().value2, '.json')",
					"type": "Expression"
				},
				"container": "ipl-bronze"
			}
		},
		"schema": {}
	}
}